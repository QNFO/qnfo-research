# ============================================================================
# .gitignore for measurable-vs-imaginable — QNFO research project
# ============================================================================

# --- Ephemeral / JIT scratch scripts (NEVER durable, may contain tokens) ---
_*.py
_*.js
_*.sh
__pycache__/
*.pyc

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- Build artifacts (rebuild from source, don't version binaries) ---
*.aux
*.log
*.out
*.toc
*.synctex.gz
build/

# --- Credentials ---
*.token
*_token
*_secret
.env
.env.*
keys.json

# --- Local-only working files ---
*.tmp
*.bak
~$*

# --- Wrangler ephemeral state ---
.wrangler/
