{"data":{"id":"10.5281/zenodo.22159758","type":"dois","attributes":{"doi":"10.5281/zenodo.22159758","prefix":"10.5281","suffix":"zenodo.22159758","identifiers":[{"identifier":"oai:zenodo.org:22159758","identifierType":"oai"}],"alternateIdentifiers":[{"alternateIdentifierType":"oai","alternateIdentifier":"oai:zenodo.org:22159758"}],"creators":[{"name":"Quni-Gudzinas, Rowan Brad","nameType":"Personal","givenName":"Rowan Brad","familyName":"Quni-Gudzinas","affiliation":["QNFO"],"nameIdentifiers":[{"nameIdentifier":"0009-0002-4317-5604","nameIdentifierScheme":"ORCID"}]}],"titles":[{"title":"The Corrected Primon-Gas Dictionary: Zeta Partition Functions and the Discipline of Arithmetic Interpretations"}],"publisher":"Zenodo","container":{},"publicationYear":2026,"subjects":[{"subject":"primon gas"},{"subject":"zeta function"},{"subject":"partition function"},{"subject":"quantum statistics"},{"subject":"Riemann zeros"},{"subject":"Gentile statistics"},{"subject":"spectral statistics"},{"subject":"arithmetic dictionary"},{"subject":"Bost-Connes"},{"subject":"prime gaps"}],"contributors":[],"dates":[{"date":"2026-08-29","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22133122","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22124744","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22142794","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22152967","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22150472","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22046458","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.21916939","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.22076816","relatedIdentifierType":"DOI"},{"relationType":"Cites","relatedIdentifier":"10.5281/zenodo.21905186","relatedIdentifierType":"DOI"},{"relationType":"IsVersionOf","relatedIdentifier":"10.5281/zenodo.22159757","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"The primon gas - a free quantum gas whose single-particle modes are indexed by the primes, with energies equal to the logarithms of the primes - has connected quantum statistical mechanics with multiplicative number theory since the early 1990s and remains in active use in high-energy theory. This paper consolidates the correspondence into a single audited reference: a term-by-term dictionary in which every entry is corrected and every formula is verified by deposited deterministic computations, a five-level ladder that separates mathematical isomorphism from physical realization claims, and a negative list stating what the correspondence does not license. The deposit contains the paper (Markdown, HTML, PDF), the citation database, the two deterministic verification suites with their outputs (52 checks), the corrected dictionary reference, and the supporting documentation. The dictionary is exact and model-specific. The premises end where a physical temperature would be identified at a p-adic place, and no such identification is asserted.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://zenodo.org/doi/10.5281/zenodo.22159758","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"api","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":9,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-08-29T09:42:12.000Z","registered":"2026-08-29T09:42:12.000Z","published":"2026","updated":"2026-08-29T09:42:12.000Z"},"relationships":{"client":{"data":{"id":"cern.zenodo","type":"clients"}},"provider":{"data":{"id":"cern","type":"providers"}},"media":{"data":{"id":"10.5281/zenodo.22159758","type":"media"}},"references":{"data":[{"id":"10.5281/zenodo.22124744","type":"dois"},{"id":"10.5281/zenodo.22152967","type":"dois"},{"id":"10.5281/zenodo.22133122","type":"dois"},{"id":"10.5281/zenodo.22046458","type":"dois"},{"id":"10.5281/zenodo.22150472","type":"dois"},{"id":"10.5281/zenodo.22076816","type":"dois"},{"id":"10.5281/zenodo.21916939","type":"dois"},{"id":"10.5281/zenodo.22142794","type":"dois"},{"id":"10.5281/zenodo.21905186","type":"dois"}]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.5281/zenodo.22159757","type":"dois"}]}}}}